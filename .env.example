# Vite development proxy target. Keep credentials out of VITE_* variables.
API_TARGET=http://127.0.0.1:8000
# Optional browser-visible API base. Default /api uses the development proxy.
# VITE_API_BASE=https://backend.example.com

# Match the proxy target to isolate sessions and link to the correct API docs.
VITE_API_ORIGIN=http://127.0.0.1:8000
VITE_ENVIRONMENT_LABEL=Local
