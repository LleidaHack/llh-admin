# Server-side proxy target for /api rewrites (Next.js). Keep credentials out of NEXT_PUBLIC_* vars.
API_TARGET=http://127.0.0.1:8000
# Optional browser-visible API base. Default /api uses the Next.js rewrite proxy.
# NEXT_PUBLIC_API_BASE=https://backend.example.com

# Match the proxy target to isolate sessions and link to the correct API docs.
NEXT_PUBLIC_API_ORIGIN=http://127.0.0.1:8000
NEXT_PUBLIC_ENVIRONMENT_LABEL=Local
